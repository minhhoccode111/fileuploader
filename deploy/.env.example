# fileuploader — production environment, on the VPS.
# Copy to .env and replace every CHANGE_ME. Keep .env out of git.
# cf. config/config.go — required fields must all be present.

# Compose reads this: plain `docker compose` then targets the prod file.
COMPOSE_FILE=docker-compose.prod.yml

# App
APP_NAME=file-uploader
APP_VERSION=1.0.0

# HTTP. Fake latency stays off in production (non-positive max disables it).
HTTP_PORT=8090
HTTP_USE_PREFORK_MODE=false
HTTP_FAKE_LATENCY_MIN=0s
HTTP_FAKE_LATENCY_MAX=0s

# Metrics and pprof listener. Loopback on the host via the compose port
# mapping; inside the container it must bind every interface.
OBSERVE_ENABLED=true
OBSERVE_ADDR=0.0.0.0:9090

# Logger
LOG_LEVEL=info

# PG. The password in PG_URL must equal POSTGRES_PASSWORD below.
PG_POOL_MAX=10
PG_URL=postgres://fileuploader:CHANGE_ME@db:5432/fileuploader

# Redis
REDIS_ADDR=redis:6379

# MinIO (own instance in this stack; not the host-wide s3.minhhoccode111.com)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=fileuploader
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
MINIO_BUCKET=files
# The app streams object bytes itself, so no public endpoint is handed out.
# Set only if presigned links are ever used: fileuploader.minhhoccode111.com
MINIO_PUBLIC_ENDPOINT=

# Uploads
UPLOAD_MAX_BYTES=10737418240
UPLOAD_PART_BYTES=52428800
UPLOAD_SESSION_IDLE_TTL=1h
UPLOAD_TIMEOUT=5m

# Global limits (zero means unlimited)
STORAGE_DEFAULT_QUOTA_BYTES=0
UPLOAD_DEFAULT_RATE_BYTES_PER_SEC=0
DOWNLOAD_DEFAULT_RATE_BYTES_PER_SEC=0

# Session
SESSION_TTL=24h

# Container-native settings (read by the db and minio containers themselves;
# the app ignores them). MINIO_ROOT_PASSWORD must equal MINIO_SECRET_KEY.
POSTGRES_DB=fileuploader
POSTGRES_USER=fileuploader
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=fileuploader
MINIO_ROOT_PASSWORD=CHANGE_ME

# Deploy pin. Unset (or latest) follows CI; a commit sha freezes the app
# on that image until the line is removed again.
IMAGE_TAG=
