package templates

templ Index() {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>File Uploader</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/htmx.min.js"></script>
			<script defer src="/static/js/alpine.min.js"></script>
		</head>
		<body class="bg-base-200 min-h-screen">
			<main class="container mx-auto p-8" x-data="{ files: [] }">
				<h1 class="text-3xl font-bold mb-4">File Uploader</h1>
				<button class="btn btn-primary" x-on:click="files.push('demo.txt')">Add file</button>
				<ul class="list bg-base-100 rounded-box mt-4 p-4">
					<template x-for="file in files">
						<li x-text="file"></li>
					</template>
				</ul>
			</main>
		</body>
	</html>
}
