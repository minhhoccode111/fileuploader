package templates

import (
	"strconv"

	"github.com/minhhoccode111/fileuploader/internal/controller/web/response"
)

// AdminUsers is the user management page of the admin area.
templ AdminUsers(view View, filters response.UserFilters) {
	@AdminLayout(AdminUsersTitle, view) {
		@AdminUsersContent(filters)
	}
}

// AdminUsersContent is the fragment htmx swaps into <main> on client-side navigation.
templ AdminUsersContent(filters response.UserFilters) {
	@PageColumnWide() {
		// The drawer of the account list holds the editor of one account: the
		// checkbox makes it pure CSS, a row click asks for the form fragment into
		// the panel on the right, and the save swaps the panel while the list
		// behind reloads itself.
		<div class="drawer drawer-end">
			<input
				id="user-edit-drawer"
				type="checkbox"
				class="drawer-toggle"
				autocomplete="off"
			/>
			<div class="drawer-content">
				<section class="card bg-base-100 shadow">
					<div class="card-body gap-4">
						<h2 class="text-2xl font-bold tracking-tight">Users</h2>
						<p class="text-base-content/70">The account list arrives on its own, right after the page. Search it by name or email, narrow it by role or day, sort it by any column, and page through what is left. The address bar keeps the filters and the order, so a view stays bookmarkable. Click a row to edit the account.</p>
						// The filters live outside the swapped list, so what the admin
						// typed stays on the screen while the rows behind it reload. A
						// GET request of htmx carries no form fields on its own, so the
						// pieces that ask for rows name the form and the rows selector.
						@AdminUsersFilters(filters)
						<div
							id="admin-users"
							class="overflow-x-auto"
							hx-get="/htmx/admin/users"
							hx-trigger="load, usersUpdated from:body"
							hx-include="#user-filters, #user-limit, #user-page, #user-sort, #user-dir"
							hx-swap="innerHTML"
						>
							// The pending state holds the rows selector, the page
							// window and the order as well, so the request the load
							// trigger sends already carries the view the address bar
							// brought; otherwise a bookmark opened with a page size or
							// a column order would answer with the default instead.
							<div class="flex flex-col gap-3">
								@AdminUsersLoading()
								@AdminUsersSortState(filters)
								<nav class="flex items-center justify-end" aria-label="Rows per page">
									@AdminUsersLimit(filters.Limit)
								</nav>
								@AdminUsersPage(filters.Page)
							</div>
						</div>
					</div>
				</section>
			</div>
			<div class="drawer-side z-30">
				<label for="user-edit-drawer" aria-label="Close the account editor" class="drawer-overlay"></label>
				<aside id="user-edit-panel" class="bg-base-100 min-h-full w-96"></aside>
			</div>
		</div>
	}
}

// AdminUsersFilters is the search bar of the account list. The Search button
// and the Enter key re-fetch the rows, and the Clear button — on the screen
// only while a filter narrows the list — empties every field and re-fetches.
// The rows-per-page control lives with the pager under the table.
templ AdminUsersFilters(filters response.UserFilters) {
	<form
		id="user-filters"
		class="flex flex-wrap items-center gap-2"
		hx-get="/htmx/admin/users"
		hx-trigger="submit, reset delay:10ms"
		hx-include="#user-limit, #user-sort, #user-dir"
		hx-target="#admin-users"
		hx-swap="innerHTML"
	>
		<label class="input input-sm items-center gap-2 grow max-w-64">
			<span class="label">Search</span>
			<input type="search" name="q" placeholder="Username or email" value={ filters.Query } autocomplete="off"/>
		</label>
		<select name="role" class="select select-sm" aria-label="Role">
			<option value="all" selected?={ filters.Role != "user" && filters.Role != "admin" }>All roles</option>
			<option value="user" selected?={ filters.Role == "user" }>user</option>
			<option value="admin" selected?={ filters.Role == "admin" }>admin</option>
		</select>
		<select name="status" class="select select-sm" aria-label="Status">
			<option value="all" selected?={ filters.Status != "pending" && filters.Status != "active" && filters.Status != "disabled" }>All statuses</option>
			<option value="pending" selected?={ filters.Status == "pending" }>pending</option>
			<option value="active" selected?={ filters.Status == "active" }>active</option>
			<option value="disabled" selected?={ filters.Status == "disabled" }>disabled</option>
		</select>
		<input type="date" name="date" class="input input-sm" value={ filters.Date } aria-label="Created or updated on"/>
		@AdminUsersClear(!filters.Active)
		<button type="submit" class="btn btn-sm btn-primary">Search</button>
	</form>
}

// AdminUsersClear is the Clear button of the search bar. It is hidden while
// nothing narrows the list, and the table response turns it on and off in
// place, so the form it resets never moves.
templ AdminUsersClear(hidden bool) {
	<button type="reset" class="btn btn-ghost btn-sm" id="user-clear" hidden?={ hidden }>Clear</button>
}

// AdminUsersSortState is the order of the table, carried as hidden fields so
// the requests that reload the rows keep the column the visitor chose. It
// travels with the list, so it is replaced by every response.
templ AdminUsersSortState(filters response.UserFilters) {
	<input type="hidden" id="user-sort" name="sort" value={ filters.Sort }/>
	<input type="hidden" id="user-dir" name="dir" value={ filters.Dir }/>
}

// AdminUsersSortHeader is one clickable column title. A click asks for the
// rows ordered by this column, in the direction the server picked: the other
// direction when the table is already ordered by it, ascending otherwise. The
// href carries the same view, so the column also works without htmx and the
// state stays bookmarkable.
templ AdminUsersSortHeader(filters response.UserFilters, field, label string) {
	{{ sort := filters.SortColumn(field) }}
	<th aria-sort={ sort.AriaSort() }>
		<a
			class="link link-hover inline-flex items-center gap-1"
			href={ templ.URL("/admin/users?" + sort.Query) }
			hx-get="/htmx/admin/users"
			hx-vals={ templ.JSONString(sort.Values()) }
			hx-include="#user-filters, #user-limit"
			hx-target="#admin-users"
			hx-swap="innerHTML"
		>
			{ label }
			if sort.Active {
				if sort.Ascending {
					<span aria-hidden="true">▲</span>
				} else {
					<span aria-hidden="true">▼</span>
				}
			} else {
				<span class="opacity-40" aria-hidden="true">↕</span>
			}
		</a>
	</th>
}

// AdminUsersLoading is what the account table shows while the rows are on their
// way.
templ AdminUsersLoading() {
	<div class="flex w-full flex-col gap-3">
		<div class="skeleton h-10 w-full"></div>
		<div class="skeleton h-10 w-full"></div>
		<div class="skeleton h-10 w-full"></div>
	</div>
}

// AdminUsersFragment is the answer to an account-table request: the table
// with its pager, plus the in-place update that turns the Clear button on
// and off after the filters changed.
templ AdminUsersFragment(rows []response.UserRow, pager response.UserPager, filters response.UserFilters) {
	@AdminUsersTable(rows, pager, filters)
	if filters.Active {
		<hx-partial hx-target="#user-clear" hx-swap="outerHTML">
			@AdminUsersClear(false)
		</hx-partial>
	} else {
		<hx-partial hx-target="#user-clear" hx-swap="outerHTML">
			@AdminUsersClear(true)
		</hx-partial>
	}
}

// AdminUsersTable is the table of accounts plus its pager. The admin page
// asks for it with htmx once the page is on the screen, and the filters and
// the pager re-ask for it on every change.
templ AdminUsersTable(rows []response.UserRow, pager response.UserPager, filters response.UserFilters) {
	<div class="flex flex-col gap-3">
		@AdminUsersSortState(filters)
		// The fixed layout keeps every column at the same share of the table
		// whatever the rows hold. A long name or email is cut with an ellipsis
		// and its full value moves to the tooltip, so a new page never widens a
		// column, wraps a row or moves the layout under the visitor.
		<table class="table table-zebra table-fixed w-full min-w-[56rem]">
			<colgroup>
				<col class="w-[20%]"/>
				<col class="w-[26%]"/>
				<col class="w-[10%]"/>
				<col class="w-[10%]"/>
				<col class="w-[17%]"/>
				<col class="w-[17%]"/>
			</colgroup>
			<thead>
				<tr>
					@AdminUsersSortHeader(filters, "username", "Username")
					@AdminUsersSortHeader(filters, "email", "Email")
					@AdminUsersSortHeader(filters, "role", "Role")
					<th class="whitespace-nowrap">Status</th>
					@AdminUsersSortHeader(filters, "created_at", "Joined")
					@AdminUsersSortHeader(filters, "updated_at", "Updated")
				</tr>
			</thead>
			<tbody>
				if len(rows) == 0 {
					<tr>
						if filters.Active {
							<td class="text-base-content/70" colspan="6">No account matches the filters.</td>
						} else {
							<td class="text-base-content/70" colspan="6">No accounts yet.</td>
						}
					</tr>
				} else {
					for _, row := range rows {
						<tr
							class="cursor-pointer hover:bg-base-200/50"
							aria-label={ "Edit " + row.Username }
							hx-get="/htmx/admin/users/edit"
							hx-vals={ templ.JSONString(map[string]string{"id": row.ID}) }
							hx-target="#user-edit-panel"
							hx-swap="innerHTML"
							hx-on:htmx:after:swap="document.getElementById('user-edit-drawer').checked = true"
						>
							<td class="font-medium">
								<span class="block truncate" title={ row.Username }>{ row.Username }</span>
							</td>
							<td>
								<span class="block truncate" title={ row.Email }>{ row.Email }</span>
							</td>
							<td class="whitespace-nowrap">
								if row.IsAdmin {
									<span class="badge badge-primary">admin</span>
								} else {
									<span class="badge badge-neutral">user</span>
								}
							</td>
							<td class="whitespace-nowrap">
								if row.Status == "active" {
									<span class="badge badge-success">active</span>
								} else if row.Status == "pending" {
									<span class="badge badge-warning">pending</span>
								} else {
									<span class="badge badge-error">disabled</span>
								}
							</td>
							<td class="whitespace-nowrap">{ row.Joined }</td>
							<td class="whitespace-nowrap">{ row.Updated }</td>
						</tr>
					}
				}
			</tbody>
		</table>
		@AdminUsersPage(pager.Page)
		@AdminUsersPager(pager, filters.Limit)
	</div>
}

// AdminUsersLimit is the rows-per-page selector. It asks for the rows on its
// own change, and it renders twice: with the pager on the screen and in the
// pending place the page shows first, because the request the load trigger
// sends has no pager yet to carry the limit with.
templ AdminUsersLimit(limit string) {
	<label class="flex items-center gap-1 text-sm">
		<span>Rows</span>
		<select
			id="user-limit"
			name="limit"
			class="select select-sm"
			aria-label="Rows per page"
			hx-get="/htmx/admin/users"
			hx-trigger="change"
			hx-include="#user-filters, #user-sort, #user-dir"
			hx-target="#admin-users"
			hx-swap="innerHTML"
		>
			<option value="5" selected?={ limit == "5" }>5</option>
			<option value="10" selected?={ limit == "10" }>10</option>
			<option value="20" selected?={ limit == "20" }>20</option>
			<option value="50" selected?={ limit == "50" }>50</option>
		</select>
	</label>
}

// AdminUsersPage is the hidden page window of the list. It travels with the
// list, so the load trigger re-asks for the window a bookmark carries and a
// response always pins it to the window just served; the controls that
// narrow the list leave it out, which is how a new filter starts over at
// the first page.
templ AdminUsersPage(page int) {
	<input type="hidden" id="user-page" name="page" value={ page }/>
}

// AdminUsersPager is the window bar under the account table: the number of
// accounts the filters matched, the rows-per-page selector, which asks for
// the rows on its own change, and the pager, which walks one page at a time
// while carrying the filters with it.
templ AdminUsersPager(pager response.UserPager, limit string) {
	<nav class="flex flex-wrap items-center justify-between gap-2" aria-label="Account pages">
		<span class="text-sm text-base-content/70">{ pager.Total } accounts</span>
		<div class="flex items-center justify-end gap-2">
			@AdminUsersLimit(limit)
			<div class="join">
				<button
					type="button"
					class="join-item btn btn-sm active:translate-none!"
					disabled?={ pager.Prev == 0 }
					hx-get="/htmx/admin/users"
					hx-include="#user-filters, #user-limit, #user-sort, #user-dir"
					hx-vals={ templ.JSONString(map[string]int{"page": pager.Prev}) }
					hx-target="#admin-users"
					hx-swap="innerHTML"
				>«</button>
				<span class="join-item btn btn-sm btn-ghost pointer-events-none">Page { pager.Page } of { pager.Pages }</span>
				<button
					type="button"
					class="join-item btn btn-sm active:translate-none!"
					disabled?={ pager.Next == 0 }
					hx-get="/htmx/admin/users"
					hx-include="#user-filters, #user-limit, #user-sort, #user-dir"
					hx-vals={ templ.JSONString(map[string]int{"page": pager.Next}) }
					hx-target="#admin-users"
					hx-swap="innerHTML"
				>»</button>
			</div>
		</div>
	</nav>
}

// AdminSettings is the settings page of the admin area.
templ AdminSettings(view View) {
	@AdminLayout(AdminSettingsTitle, view) {
		@AdminSettingsContent()
	}
}

// AdminSettingsContent is the fragment htmx swaps into <main> on client-side navigation.
templ AdminSettingsContent() {
	@PageColumnWide() {
		<section class="card bg-base-100 shadow">
			<div class="card-body gap-4">
				<h1 class="text-4xl font-bold tracking-tight">Hello from Admin Settings</h1>
				<p class="text-base-content/70 max-w-prose">This page is only reachable when you are signed in as an admin.</p>
			</div>
		</section>
		<section class="card bg-base-100 shadow">
			<div class="card-body gap-4">
				<h2 class="text-2xl font-bold tracking-tight">Settings</h2>
				<p class="text-base-content/70 max-w-prose">The settings of the app land here. Until then, this page only says hello.</p>
			</div>
		</section>
	}
}

// AdminUsersEditContent is the fragment the drawer of the account list fills
// when a row is clicked: the form of the account that row holds.
templ AdminUsersEditContent(row response.UserRow) {
	@adminUsersEditForm(row, "")
}

// AdminUsersEditDone is the answer the drawer shows after an account was
// saved: the note of the save above the form, with the values the account
// now carries, so a second edit starts from what the server has.
templ AdminUsersEditDone(row response.UserRow, sessionsEnded bool) {
	if sessionsEnded {
		@adminUsersEditForm(
			row,
			"The account was saved. Every live session of the account was ended, so the new role or password applies on the next sign-in.",
		)
	} else {
		@adminUsersEditForm(row, "The account was saved.")
	}
}

// adminUsersEditForm is the body of the account editor: the fields, the error
// target the server answers with, and the actions. Validation errors come back
// with other statuses, so the form pins its success swap to the panel and the
// error swap to the error line, which keeps what the admin typed on the screen.
templ adminUsersEditForm(row response.UserRow, note string) {
	<div class="flex flex-col gap-4 p-4">
		if note != "" {
			<div role="alert" class="alert alert-success">
				<svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
				<span>{ note }</span>
			</div>
		}
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-bold">Edit { row.Username }</h3>
			<label for="user-edit-drawer" aria-label="Close the account editor" class="btn btn-circle btn-ghost btn-sm">✕</label>
		</div>
		<form
			id="user-edit-form"
			class="flex flex-col gap-3"
			novalidate
			hx-post="/htmx/admin/users/edit"
			hx-target="#user-edit-panel"
			hx-swap="innerHTML"
			hx-status:4xx="target:#user-edit-error"
			hx-status:5xx="target:#user-edit-error"
		>
			<input type="hidden" name="id" value={ row.ID }/>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Username</span>
				<input
					class="input w-full"
					type="text"
					name="username"
					value={ row.Username }
					required
					minlength="3"
					maxlength="255"
					autocomplete="username"
				/>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Email</span>
				<input
					class="input w-full"
					type="email"
					name="email"
					value={ row.Email }
					required
					maxlength="255"
					autocomplete="email"
				/>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Role</span>
				<select name="role" class="select w-full">
					<option value="user" selected?={ !row.IsAdmin }>user</option>
					<option value="admin" selected?={ row.IsAdmin }>admin</option>
				</select>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Status</span>
				<select name="status" class="select w-full">
					<option value="pending" selected?={ row.Status == "pending" }>pending</option>
					<option value="active" selected?={ row.Status == "active" }>active</option>
					<option value="disabled" selected?={ row.Status == "disabled" }>disabled</option>
				</select>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">New password</span>
				<input
					class="input w-full"
					type="password"
					name="password"
					minlength="6"
					placeholder="Leave empty to keep the current one"
					autocomplete="new-password"
				/>
				<span class="text-xs text-base-content/60">Filling it replaces the password and ends every session the account holds.</span>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Storage quota (K/M/G or bytes)</span>
				<input
					class="input w-full"
					type="text"
					name="storage_quota"
					value={ strconv.FormatInt(row.StorageQuotaValue(), 10) }
					inputmode="text"
				/>
				<span class="text-xs text-base-content/60">Zero inherits the default. { response.ByteLabel(row.StorageQuotaValue()) }</span>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Storage used (bytes)</span>
				<input
					class="input w-full"
					type="number"
					name="storage_used_bytes"
					value={ strconv.FormatInt(row.StorageUsedValue(), 10) }
					readonly
				/>
				<span class="text-xs text-base-content/60">{ response.ByteLabel(row.StorageUsedValue()) }</span>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Upload rate (K/M/G or bytes/sec)</span>
				<input
					class="input w-full"
					type="text"
					name="upload_rate"
					value={ strconv.FormatInt(row.UploadRateValue(), 10) }
					inputmode="text"
				/>
				<span class="text-xs text-base-content/60">Zero inherits the default. { response.ByteLabel(row.UploadRateValue()) }/s</span>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Download rate (K/M/G or bytes/sec)</span>
				<input
					class="input w-full"
					type="text"
					name="download_rate"
					value={ strconv.FormatInt(row.DownloadRateValue(), 10) }
					inputmode="text"
				/>
				<span class="text-xs text-base-content/60">Zero inherits the default. { response.ByteLabel(row.DownloadRateValue()) }/s</span>
			</label>
			<div id="user-edit-error" class="text-error text-sm" role="alert"></div>
			<button type="submit" class="btn btn-primary">Save</button>
			<label for="user-edit-drawer" class="btn btn-ghost">Cancel</label>
		</form>
	</div>
}

// RoleUpdated reports that the role of an account was changed.
templ RoleUpdated(email, role string) {
	<div role="alert" class="alert alert-success">
		<svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
		</svg>
		<span>{ email } is now { role }. Their sessions were ended, so the new role applies on the next sign-in.</span>
	</div>
}

// AdminAccessRequests is the access-request approval page of the admin area.
templ AdminAccessRequests(view View, filters response.UserFilters) {
	@AdminLayout(AdminAccessRequestsTitle, view) {
		@AdminAccessRequestsContent(filters)
	}
}

// AdminAccessRequestsContent is the fragment htmx swaps into <main>.
templ AdminAccessRequestsContent(filters response.UserFilters) {
	@PageColumnWide() {
		<section class="card bg-base-100 shadow">
			<div class="card-body gap-4">
				<h2 class="text-2xl font-bold tracking-tight">Access requests</h2>
				<p class="text-base-content/70">Accounts waiting for approval. Approving lets the account sign in.</p>
				<form
					id="access-request-filters"
					class="flex flex-wrap items-center gap-2"
					hx-get="/htmx/admin/access-requests"
					hx-trigger="submit, reset delay:10ms"
					hx-include="#access-request-limit, #access-request-sort, #access-request-dir"
					hx-target="#admin-access-requests"
					hx-swap="innerHTML"
				>
					<label class="input input-sm items-center gap-2 grow max-w-64">
						<span class="label">Search</span>
						<input type="search" name="q" placeholder="Username or email" value={ filters.Query } autocomplete="off"/>
					</label>
					<input type="date" name="date" class="input input-sm" value={ filters.Date } aria-label="Requested on"/>
					<button type="submit" class="btn btn-sm btn-primary">Search</button>
				</form>
				<div
					id="admin-access-requests"
					class="overflow-x-auto"
					hx-get="/htmx/admin/access-requests"
					hx-trigger="load, accessRequestsUpdated from:body"
					hx-include="#access-request-filters, #access-request-limit, #access-request-sort, #access-request-dir, #access-request-page"
					hx-swap="innerHTML"
				>
					<div class="flex flex-col gap-3">
						@AdminAccessRequestsLoading()
						<input type="hidden" id="access-request-sort" name="sort" value={ filters.Sort }/>
						<input type="hidden" id="access-request-dir" name="dir" value={ filters.Dir }/>
						<nav class="flex items-center justify-end" aria-label="Rows per page">
							@AdminAccessRequestsLimit(filters.Limit)
						</nav>
						<input type="hidden" id="access-request-page" name="page" value={ strconv.Itoa(filters.Page) }/>
					</div>
				</div>
			</div>
		</section>
	}
}

templ AdminAccessRequestsLoading() {
	<div class="flex flex-col gap-3">
		<div class="skeleton h-8 w-full"></div>
		<div class="skeleton h-8 w-full"></div>
	</div>
}

templ AdminAccessRequestsLimit(limit string) {
	<label class="flex items-center gap-1 text-sm">
		<span>Rows</span>
		<select
			id="access-request-limit"
			name="limit"
			class="select select-sm"
			aria-label="Rows per page"
			hx-get="/htmx/admin/access-requests"
			hx-trigger="change"
			hx-include="#access-request-filters, #access-request-sort, #access-request-dir"
			hx-target="#admin-access-requests"
			hx-swap="innerHTML"
		>
			<option value="5" selected?={ limit == "5" }>5</option>
			<option value="10" selected?={ limit == "10" || limit == "" }>10</option>
			<option value="20" selected?={ limit == "20" }>20</option>
			<option value="50" selected?={ limit == "50" }>50</option>
		</select>
	</label>
}

templ AdminAccessRequestsFragment(rows []response.UserRow, pager response.UserPager, filters response.UserFilters) {
	@AdminAccessRequestsTable(rows, pager, filters)
}

templ AdminAccessRequestsTable(rows []response.UserRow, pager response.UserPager, filters response.UserFilters) {
	<div class="flex flex-col gap-3">
		<input type="hidden" id="access-request-sort" name="sort" value={ filters.Sort }/>
		<input type="hidden" id="access-request-dir" name="dir" value={ filters.Dir }/>
		<input type="hidden" id="access-request-page" name="page" value={ strconv.Itoa(pager.Page) }/>
		<table class="table table-zebra table-fixed w-full min-w-[48rem]">
			<colgroup>
				<col class="w-[24%]"/>
				<col class="w-[32%]"/>
				<col class="w-[24%]"/>
				<col class="w-[20%]"/>
			</colgroup>
			<thead>
				<tr>
					<th>Username</th>
					<th>Email</th>
					<th>Requested</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				if len(rows) == 0 {
					<tr>
						<td class="text-base-content/70" colspan="4">No pending requests.</td>
					</tr>
				} else {
					for _, row := range rows {
						<tr>
							<td class="font-medium">
								<span class="block truncate" title={ row.Username }>{ row.Username }</span>
							</td>
							<td>
								<span class="block truncate" title={ row.Email }>{ row.Email }</span>
							</td>
							<td class="whitespace-nowrap">{ row.Joined }</td>
							<td>
								<button
									type="button"
									class="btn btn-sm btn-primary"
									hx-post="/htmx/admin/access-requests/approve"
									hx-vals={ templ.JSONString(map[string]string{"id": row.ID}) }
									hx-target="#admin-access-requests"
									hx-swap="innerHTML"
								>Approve</button>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
		<nav class="flex items-center justify-end" aria-label="Rows per page">
			@AdminAccessRequestsLimit(filters.Limit)
		</nav>
		@AdminAccessRequestsPage(pager, filters)
	</div>
}

templ AdminAccessRequestsPage(pager response.UserPager, filters response.UserFilters) {
	<nav class="flex items-center justify-between" aria-label="Pagination">
		<span class="text-sm text-base-content/70">Page { strconv.Itoa(pager.Page) } of { strconv.Itoa(pager.Pages) }</span>
		<div class="join">
			<button type="button" class="join-item btn btn-sm" disabled?={ pager.Prev == 0 } hx-get="/htmx/admin/access-requests" hx-vals={ templ.JSONString(map[string]int{"page": pager.Prev}) } hx-include="#access-request-filters, #access-request-limit, #access-request-sort, #access-request-dir" hx-target="#admin-access-requests" hx-swap="innerHTML">«</button>
			<button type="button" class="join-item btn btn-sm" disabled?={ pager.Next == 0 } hx-get="/htmx/admin/access-requests" hx-vals={ templ.JSONString(map[string]int{"page": pager.Next}) } hx-include="#access-request-filters, #access-request-limit, #access-request-sort, #access-request-dir" hx-target="#admin-access-requests" hx-swap="innerHTML">»</button>
		</div>
	</nav>
}
