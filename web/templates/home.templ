package templates

templ Home() {
	@Layout("Home") {
		<section class="card bg-base-100 shadow">
			<div class="card-body gap-4">
				<h1 class="text-4xl font-bold tracking-tight">Send large files without clutter.</h1>
				<p class="text-base-content/70 max-w-prose">Upload, share and collect files through one small service. Sign in to manage your uploads, or create an account to start.</p>
				<div class="flex flex-wrap gap-2 pt-2">
					<a href="/login" class="btn btn-primary">Login</a>
					<a href="/register" class="btn btn-ghost border border-base-300">Register</a>
				</div>
			</div>
		</section>
	}
}
