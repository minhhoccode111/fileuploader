package templates

templ Login(view View) {
	@Layout(LoginTitle, view) {
		@LoginContent(view.DemoLogin)
	}
}

// LoginContent is the fragment htmx swaps into <main>. The demo hint appears
// only when a demo account is seeded; the x-data scope is empty without one,
// so the form works exactly as it did before.
templ LoginContent(demo *DemoLogin) {
	@PageColumn() {
		<section class="card bg-base-100 mx-auto w-full max-w-md shadow">
		<div class="card-body" x-data={ templ.JSONString(demo.State()) }>
			<h1 class="text-3xl font-bold tracking-tight">Welcome back</h1>
			<p class="text-base-content/70">Sign in with your email and password.</p>
			<form
				id="login-form"
				class="flex flex-col gap-4 py-2"
				hx-post="/htmx/login"
				hx-target="#login-error"
				hx-swap="innerHTML"
				novalidate
			>
				<label class="flex flex-col gap-1">
					<span class="text-sm font-medium">Email</span>
					<input
						class="input input-bordered w-full"
						type="email"
						name="email"
						required
						autocomplete="email"
						x-ref="email"
					/>
				</label>
				<label class="flex flex-col gap-1">
					<span class="text-sm font-medium">Password</span>
					<input
						class="input input-bordered w-full"
						type="password"
						name="password"
						required
						autocomplete="current-password"
						x-ref="password"
					/>
				</label>
				<button class="btn btn-primary" type="submit">Login</button>
				<div id="login-error" class="text-sm text-error" role="alert"></div>
			</form>
			<p class="text-sm">
				No account?
				<a
					href="/register"
					hx-get="/register"
					hx-target="#page-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					class="link link-primary"
				>Register</a>
			</p>
			if demo != nil {
				<div class="divider"></div>
				<div class="flex items-center justify-between gap-2">
					<span class="text-sm text-base-content/70">
						Try the demo:
						<span class="font-mono">{ demo.Email }</span>
						/
						<span class="font-mono">{ demo.Password }</span>
					</span>
					<button
						type="button"
						class="btn btn-ghost btn-xs"
						@click="$refs.email.value = demoEmail; $refs.password.value = demoPassword"
					>Fill in</button>
				</div>
			}
		</div>
	</section>
	}
}
