package templates

import "github.com/minhhoccode111/fileuploader/internal/controller/web/response"

// ShareIndex is the page where an account manages the folders it has shared.
templ ShareIndex(view View, shares []response.ShareRow) {
	@Layout(ShareTitle, view) {
		@ShareIndexContent(shares)
	}
}

// ShareIndexContent is the fragment htmx swaps into <main>. The drawer is part
// of the page, so every action opens in the same panel on the right.
templ ShareIndexContent(shares []response.ShareRow) {
	@PageColumnWide() {
		<div class="drawer drawer-end">
			<input
				id="entry-drawer"
				type="checkbox"
				class="drawer-toggle"
				autocomplete="off"
			/>
			<div class="drawer-content flex flex-col gap-4">
				<section class="card bg-base-100 shadow">
					<div class="card-body gap-4">
						<h1 class="text-3xl font-bold tracking-tight">Shared folders</h1>
						<div id="share-rows" class="overflow-x-auto">
							@ShareRows(shares)
						</div>
					</div>
				</section>
			</div>
			<div class="drawer-side z-30">
				<label for="entry-drawer" aria-label="Close the panel" class="drawer-overlay"></label>
				<aside id="entry-panel" class="bg-base-100 min-h-full w-1/2"></aside>
			</div>
		</div>
	}
}

// ShareRows is the table of shares, and the target every share action refreshes.
templ ShareRows(shares []response.ShareRow) {
	if len(shares) == 0 {
		<div class="rounded-box border-base-300 border border-dashed p-10 text-center">
			<p class="text-base-content/70 text-sm">You have not shared any folder yet.</p>
		</div>
	} else {
		<table class="table table-zebra table-fixed w-full">
			<thead>
				<tr>
					<th>Folder</th>
					<th>Link</th>
					<th>Expires</th>
					<th class="w-12 pe-0"><span class="sr-only">Actions</span></th>
				</tr>
			</thead>
			<tbody>
				for _, share := range shares {
					<tr>
						<td class="font-medium">
							<a href={ templ.URL(share.Link) } class="link link-primary">{ share.FolderName }</a>
						</td>
						<td class="text-xs break-all">{ share.Link }</td>
						<td class="whitespace-nowrap">{ share.Expires }</td>
						<td class="pe-0 text-right">
							<button
								type="button"
								class="btn btn-square btn-ghost btn-sm"
								aria-label={ "Actions for share of " + share.FolderName }
								hx-get={ "/htmx/shares/" + share.ID }
								hx-target="#entry-panel"
								hx-swap="innerHTML"
								hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
									<circle cx="12" cy="5" r="1.7"></circle>
									<circle cx="12" cy="12" r="1.7"></circle>
									<circle cx="12" cy="19" r="1.7"></circle>
								</svg>
							</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// ShareDrawerContent is the drawer one share opens from the actions button: the
// link, the expiry form and the delete form.
templ ShareDrawerContent(share response.ShareRow) {
	<div class="flex flex-col gap-4 p-4">
		<div class="flex items-start justify-between gap-2">
			<h3 class="text-lg font-bold break-all">{ share.FolderName }</h3>
			<label for="entry-drawer" aria-label="Close the panel" class="btn btn-circle btn-ghost btn-sm">✕</label>
		</div>
		<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
			<dt class="text-base-content/60">Link</dt>
			<dd class="break-all">{ share.Link }</dd>
			<dt class="text-base-content/60">Expires</dt>
			<dd class="whitespace-nowrap">{ share.Expires }</dd>
		</dl>
		<button
			type="button"
			class="btn btn-primary"
			data-share-link={ share.Link }
			onclick="copyShareLink(this)"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
				<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
				<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
			</svg>
			<span data-share-label>Copy link</span>
		</button>
		<form
			class="flex flex-col gap-3"
			novalidate
			hx-post={ "/htmx/shares/" + share.ID + "/time" }
			hx-target="#share-rows"
			hx-swap="innerHTML"
			hx-status:4xx="target:#share-expiry-error"
			hx-status:5xx="target:#share-expiry-error"
		>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Valid until</span>
				<input
					class="input w-full"
					type="datetime-local"
					name="expires_at"
					if share.ExpiresAt != nil {
						value={ share.ExpiresAt.Format("2006-01-02T15:04") }
					}
				/>
			</label>
			<label class="flex items-center gap-2 text-sm">
				<input type="checkbox" name="unlimited" value="true" class="checkbox"/>
				No expiry (unlimited)
			</label>
			<div id="share-expiry-error" class="text-error text-sm" role="alert"></div>
			<button type="submit" class="btn btn-sm">Save expiry</button>
		</form>
		<form
			hx-post={ "/htmx/shares/" + share.ID + "/delete" }
			hx-target="#share-rows"
			hx-swap="innerHTML"
			hx-confirm="Stop sharing this folder?"
			hx-status:4xx="target:#share-delete-error"
			hx-status:5xx="target:#share-delete-error"
		>
			<div id="share-delete-error" class="text-error text-sm" role="alert"></div>
			<button type="submit" class="btn btn-sm btn-error btn-outline">Delete share</button>
		</form>
	</div>
}

// SharedDrive is the read-only view of a shared folder.
templ SharedDrive(view View, page response.SharedDrive) {
	@Layout(SharedTitle, view) {
		@SharedDriveContent(page)
	}
}

// SharedDriveContent is the fragment htmx swaps into <main>. A share exposes no
// scope control: the local search only narrows the folder on the screen, so a
// visitor never reaches the owner's drive.
templ SharedDriveContent(page response.SharedDrive) {
	@PageColumnWide() {
		<section class="card bg-base-100 shadow">
			<div class="card-body gap-4">
				<nav aria-label="Breadcrumb" class="breadcrumbs text-sm">
					<ul>
						for _, crumb := range page.Breadcrumb {
							<li>
								if crumb.Current {
									<span aria-current="page">{ crumb.Name }</span>
								} else {
									<a href={ templ.URL(crumb.Href) } hx-get={ crumb.Href } hx-target="#page-content" hx-swap="innerHTML" hx-push-url="true">{ crumb.Name }</a>
								}
							</li>
						}
					</ul>
				</nav>
				@SharedEntrySearchForm(page)
				if len(page.Folders) == 0 && len(page.Files) == 0 {
					<div class="rounded-box border-base-300 border border-dashed p-10 text-center">
						<p class="text-base-content/70 text-sm">This shared folder is empty.</p>
					</div>
				} else {
					<table class="table table-zebra table-fixed w-full">
						<thead>
							<tr>
								<th>Name</th>
								<th class="w-32">Size</th>
								<th class="w-40">Modified</th>
							</tr>
						</thead>
						<tbody>
							@SharedEntryRows(page)
						</tbody>
					</table>
				}
			</div>
		</section>
	}
}

// SharedEntrySearchForm narrows the direct children of the shared folder on the
// screen. It is a plain GET form, so it works without JavaScript, and htmx swaps
// only the page content when it is available.
templ SharedEntrySearchForm(page response.SharedDrive) {
	<form
		class="flex w-full flex-wrap items-center gap-2"
		method="get"
		action={ page.SearchAction }
		hx-get={ page.SearchAction }
		hx-target="#page-content"
		hx-swap="innerHTML"
		hx-push-url="true"
	>
		<input
			class="input w-full flex-1"
			type="search"
			name="q"
			value={ page.Search }
			placeholder="Search this folder"
			aria-label="Search this folder"
			maxlength="100"
			autocomplete="off"
		/>
		<button type="submit" class="btn">Search</button>
	</form>
}

// SharedEntryRows renders the rows of a shared listing and the load-more
// sentinel, without the table around them. It is the body of the partial
// endpoint: htmx replaces the sentinel row with the rows it loaded and the
// sentinel that follows them. The table has Name, Size and Modified, so the
// sentinel cell spans three columns.
templ SharedEntryRows(page response.SharedDrive) {
	for _, folder := range page.Folders {
		<tr class="cursor-pointer hover:bg-base-200/50" aria-label={ "Open folder " + folder.Name } hx-get={ folder.Href } hx-target="#page-content" hx-swap="innerHTML" hx-push-url="true">
			<td class="font-medium">
				<span class="flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 text-warning">
						<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.5l-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z"></path>
					</svg>
					<span class="block min-w-0 flex-1 truncate" title={ folder.Name }>{ folder.Name }</span>
				</span>
			</td>
			<td class="whitespace-nowrap">{ folder.Items }</td>
			<td class="whitespace-nowrap">{ folder.Updated }</td>
		</tr>
	}
	for _, file := range page.Files {
		<tr>
			<td class="font-medium">
				<span class="flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 text-base-content/60">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
						<path d="M14 2v6h6"></path>
					</svg>
					<a href={ templ.URL(file.Download) } class="link">{ file.Name }</a>
				</span>
			</td>
			<td class="whitespace-nowrap">{ file.Size }</td>
			<td class="whitespace-nowrap">{ file.Updated }</td>
		</tr>
	}
	if page.NextURL != "" {
		<tr id="load-more">
			<td colspan="3" class="text-center">
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					hx-get={ page.NextURL }
					hx-target="closest tr"
					hx-swap="outerHTML"
					hx-trigger="click, revealed"
				>
					Load more
				</button>
			</td>
		</tr>
	}
}

// ShareCreateContent is the drawer form that creates a public link to a folder.
templ ShareCreateContent(folderID, name string) {
	<div class="flex flex-col gap-4 p-4">
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-bold break-all">Share { name }</h3>
			<label for="entry-drawer" aria-label="Close the panel" class="btn btn-circle btn-ghost btn-sm">✕</label>
		</div>
		<form
			class="flex flex-col gap-3"
			novalidate
			hx-post="/htmx/shares"
			hx-target="#drive-entries"
			hx-swap="innerHTML"
			hx-status:4xx="target:#share-error"
			hx-status:5xx="target:#share-error"
		>
			<input type="hidden" name="folder" value={ folderID }/>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Valid until</span>
				<input
					class="input w-full"
					type="datetime-local"
					name="expires_at"
				/>
			</label>
			<label class="flex items-center gap-2 text-sm">
				<input type="checkbox" name="unlimited" value="true" class="checkbox"/>
				No expiry (unlimited)
			</label>
			<div id="share-error" class="text-error text-sm" role="alert"></div>
			<button type="submit" class="btn btn-primary">Create share link</button>
			<label for="entry-drawer" class="btn btn-ghost">Cancel</label>
		</form>
	</div>
}
