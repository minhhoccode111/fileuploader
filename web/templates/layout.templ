package templates

// sidebarState seeds the drawer from the viewport width: expanded on lg+, collapsed below.
const sidebarState = "{ open: window.matchMedia('(min-width: 1024px)').matches }"

// adminMenuState opens the admin section when the page on screen lives in it,
// so a visitor who lands on an admin page sees where they are.
const adminMenuState = "{ adminOpen: window.location.pathname.startsWith('/admin') }"

// Layout is the document shell of a content page. The pages carry their own
// width: see PageColumn.
templ Layout(title string, view View) {
	@pageLayout(title, view) {
		{ children... }
	}
}

// AdminLayout is Layout with a different name: the admin pages are the pages
// that ask for the wide column, and the width itself travels with their
// fragments — see PageColumnWide.
templ AdminLayout(title string, view View) {
	@pageLayout(title, view) {
		{ children... }
	}
}

// PageColumn is the reading width a content page carries. The shell holds no
// width of its own, because htmx swaps only the inside of <main> on
// client-side navigation: a class left on the shell would keep belonging to
// whatever page the visitor first loaded, and follow them onto every other
// page.
templ PageColumn() {
	<div class="mx-auto w-full max-w-3xl px-4 py-10">
		{ children... }
	</div>
}

// PageColumnWide is the column the admin pages run: the shell already puts
// them beside the whole sidebar, so they take the width that is left.
templ PageColumnWide() {
	<div class="w-full flex-1 px-4 py-10">
		{ children... }
	</div>
}

// TitlePartial is the head-only update that follows a client-side
// navigation: the document title follows the page htmx just swapped into
// the content, because the swap itself never reaches the head.
templ TitlePartial(title string) {
	<hx-partial hx-target="title" hx-swap="outerHTML">
		<title>{ title } · File Uploader</title>
	</hx-partial>
}

templ pageLayout(title string, view View) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · File Uploader</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			// The sidebar title is revealed with a clip that follows the drawer
			// width animation, so it never wraps while the sidebar expands.
			// These rules live in the document, not in the Tailwind build, so
			// the toggle keeps working with any web/static/css/app.css.
			<style>
				.sidebar-head {
					position: relative;
					display: flex;
					height: 4rem;
					align-items: center;
				}
				.sidebar-mark {
					position: absolute;
					inset: 0;
					display: flex;
					align-items: center;
					justify-content: center;
					opacity: 1;
					transition: opacity 0.1s ease-out 0.2s;
				}
				.sidebar-title {
					position: absolute;
					left: 1rem;
					top: 0;
					height: 100%;
					display: flex;
					align-items: center;
					white-space: nowrap;
					clip-path: inset(0 100% 0 0);
					transition: clip-path 0.2s ease-out;
				}
				.drawer-toggle:checked ~ .drawer-side .sidebar-mark {
					opacity: 0;
					transition-delay: 0s;
				}
				.drawer-toggle:checked ~ .drawer-side .sidebar-title {
					clip-path: inset(0 0% 0 0);
					transition-delay: 0.1s;
				}
				#nav-progress {
					width: 0;
				}
				#nav-progress.htmx-request {
					animation: nav-progress 4s cubic-bezier(0.15, 0.85, 0.25, 1) forwards;
				}
				@keyframes nav-progress {
					from {
						width: 0;
					}
					to {
						width: 95%;
					}
				}
			</style>
			<script src="/static/js/htmx.min.js"></script>
			<script defer src="/static/js/alpine.min.js"></script>
			<script defer src="/static/js/app.js"></script>
		</head>
		<body class="bg-base-200 min-h-screen antialiased">
			// htmx marks this bar with .htmx-request while a request is in
			// flight, so a slow swap never looks like a dead click.
			<div
				id="nav-progress"
				class="htmx-indicator bg-primary fixed inset-x-0 top-0 z-50 h-1"
				aria-hidden="true"
			></div>
			<div class="drawer lg:drawer-open" x-data={ sidebarState }>
				<input
					id="app-drawer"
					type="checkbox"
					class="drawer-toggle"
					autocomplete="off"
					x-model="open"
				/>
				<div class="drawer-content flex min-h-screen flex-col">
					<header class="navbar bg-base-100 sticky top-0 z-20 shadow-sm">
						<div class="navbar-start">
							<button
								type="button"
								class="btn btn-square btn-ghost"
								aria-label="Toggle sidebar"
								:aria-expanded="open"
								@click="open = !open"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
									<rect x="3" y="3" width="18" height="18" rx="2"></rect>
									<path d="M9 3v18"></path>
								</svg>
							</button>
						</div>
						<div class="navbar-center">
							<span class="text-lg font-semibold">File Uploader</span>
						</div>
					</header>
					// The width belongs to the page the fragment belongs to,
					// never to the shell — see PageColumn.
					<main id="page-content" class="w-full flex-1">
						{ children... }
					</main>
				</div>
				<div class="drawer-side z-30 is-drawer-close:overflow-visible">
					<label for="app-drawer" aria-label="Close sidebar" class="drawer-overlay"></label>
					<aside class="bg-base-100 flex min-h-full flex-col is-drawer-close:w-14 is-drawer-open:w-64">
						// The short mark fades out first, the title wipes in after
						// it, and on close the title clears before the mark
						// comes back.
						<div class="sidebar-head px-4 is-drawer-close:px-0">
							<span class="sidebar-mark text-xl font-bold">FU</span>
							<span class="sidebar-title text-xl font-bold">File Uploader</span>
						</div>
						@SidebarNav(view)
					</aside>
				</div>
			</div>
		</body>
	</html>
}

// SidebarNav is the auth-dependent sidebar navigation, rendered as part of a
// full page.
templ SidebarNav(view View) {
	@sidebarNav(view, false)
}

// SidebarNavUpdate is the same navigation tagged as an out-of-band swap. A
// partial response that changes the auth state (login, register, logout)
// includes it so the nav follows the response without a full reload.
templ SidebarNavUpdate(view View) {
	@sidebarNav(view, true)
}

// sidebarNav renders the navigation in a single #sidebar-nav element so a
// partial response can replace the whole nav. When oob is true the element
// carries hx-swap-oob so htmx swaps it by id instead of into the request target.
templ sidebarNav(view View, oob bool) {
	<div
		id="sidebar-nav"
		if oob {
			hx-swap-oob="true"
		}
		class="flex grow flex-col"
	>
		<ul class="menu w-full grow gap-1 px-2">
			<li>
				<a
					href="/"
					hx-get="/"
					hx-target="#page-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					class="is-drawer-close:tooltip is-drawer-close:tooltip-right"
					data-tip="Home"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
						<path d="M3 10.5 12 3l9 7.5"></path>
						<path d="M5 9.5V21h14V9.5"></path>
					</svg>
					<span class="is-drawer-close:hidden">Home</span>
				</a>
			</li>
			if view.Authenticated {
				<li>
					<a
						href="/share"
						hx-get="/share"
						hx-target="#page-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						class="is-drawer-close:tooltip is-drawer-close:tooltip-right"
						data-tip="Share"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
							<circle cx="18" cy="5" r="3"></circle>
							<circle cx="6" cy="12" r="3"></circle>
							<circle cx="18" cy="19" r="3"></circle>
							<path d="m8.6 13.5 6.8 4"></path>
							<path d="m15.4 6.5-6.8 4"></path>
						</svg>
						<span class="is-drawer-close:hidden">Share</span>
					</a>
				</li>
				<li>
					<a
						href="/public"
						hx-get="/public"
						hx-target="#page-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						class="is-drawer-close:tooltip is-drawer-close:tooltip-right"
						data-tip="Public"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
							<circle cx="12" cy="12" r="10"></circle>
							<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
							<path d="M2 12h20"></path>
						</svg>
						<span class="is-drawer-close:hidden">Public</span>
					</a>
				</li>
			}
			if view.Admin {
				<li x-data={ adminMenuState }>
					<button
						type="button"
						class="is-drawer-close:tooltip is-drawer-close:tooltip-right"
						data-tip="Admin"
						@click="adminOpen = !adminOpen"
						:aria-expanded="adminOpen"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
							<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
						</svg>
						<span class="is-drawer-close:hidden">Admin</span>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 transition-transform is-drawer-close:hidden" :class="adminOpen ? 'rotate-180' : ''">
							<path d="m6 9 6 6 6-6"></path>
						</svg>
					</button>
					// The admin area is a namespace: the section opens to the
					// pages under it, collapsed drawer included, where only
					// the icons fit. The row grows from nothing to the height
					// of its content, so the section opens the way the drawer
					// does. The collapsed drawer has one column for every
					// icon, so it also cancels the indent daisyUI gives every
					// nested menu list.
					<ul
						class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 is-drawer-close:ms-0 is-drawer-close:ps-0"
						:class="adminOpen ? 'grid-rows-[1fr]' : ''"
					>
						<li class="min-h-0 flex-nowrap gap-1 overflow-hidden">
							<a
								class="shrink-0 is-drawer-close:tooltip is-drawer-close:tooltip-right"
								data-tip="Users"
								href="/admin/users"
								hx-get="/admin/users"
								hx-target="#page-content"
								hx-swap="innerHTML"
								hx-push-url="true"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
									<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
									<circle cx="9" cy="7" r="4"></circle>
									<path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
									<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
								</svg>
								<span class="is-drawer-close:hidden">Users</span>
							</a>
							<a
								class="shrink-0 is-drawer-close:tooltip is-drawer-close:tooltip-right"
								data-tip="Settings"
								href="/admin/settings"
								hx-get="/admin/settings"
								hx-target="#page-content"
								hx-swap="innerHTML"
								hx-push-url="true"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
									<circle cx="12" cy="12" r="3"></circle>
									<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
								</svg>
								<span class="is-drawer-close:hidden">Settings</span>
							</a>
						</li>
					</ul>
				</li>
			}
			if !view.Authenticated {
				<li>
					<a
						href="/login"
						hx-get="/login"
						hx-target="#page-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						class="is-drawer-close:tooltip is-drawer-close:tooltip-right"
						data-tip="Login"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
							<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
							<path d="m10 17 5-5-5-5"></path>
							<path d="M15 12H3"></path>
						</svg>
						<span class="is-drawer-close:hidden">Login</span>
					</a>
				</li>
				<li>
					<a
						href="/register"
						hx-get="/register"
						hx-target="#page-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						class="is-drawer-close:tooltip is-drawer-close:tooltip-right"
						data-tip="Register"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
							<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
							<circle cx="9" cy="7" r="4"></circle>
							<path d="M19 8v6"></path>
							<path d="M22 11h-6"></path>
						</svg>
						<span class="is-drawer-close:hidden">Register</span>
					</a>
				</li>
			}
		</ul>
		if view.Authenticated {
			<ul class="menu w-full px-2 pb-2">
				<li>
					<a
						href="/logout"
						hx-get="/logout"
						hx-target="#page-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						class="is-drawer-close:tooltip is-drawer-close:tooltip-right"
						data-tip="Logout"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
							<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
							<path d="m16 17 5-5-5-5"></path>
							<path d="M21 12H9"></path>
						</svg>
						<span class="is-drawer-close:hidden">Logout</span>
					</a>
				</li>
			</ul>
		}
	</div>
}
