package templates

import (
	"strconv"

	"github.com/minhhoccode111/fileuploader/internal/controller/web/response"
)

// filePickerState backs the upload drawer: choosing a file fills the name
// field with the file name and shows the size and the extension before the
// form is submitted.
const filePickerState = `{
	name: '',
	size: '',
	extension: '',
	formatBytes(size) {
		if (!Number.isFinite(size) || size < 0) return '0 B';
		if (size < 10) return size + ' B';
		const units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB', 'EB'];
		const base = 1024;
		let exponent = Math.floor(Math.log(size) / Math.log(base));
		if (exponent < 0) exponent = 0;
		if (exponent >= units.length) exponent = units.length - 1;
		let value = size / Math.pow(base, exponent);
		if (exponent < units.length - 1) {
			const rounded = value < 10 ? Math.round(value * 10) / 10 : Math.round(value);
			if (rounded >= base) {
				exponent += 1;
				value /= base;
			}
		}
		if (value < 10) return value.toFixed(1) + ' ' + units[exponent];
		return Math.round(value) + ' ' + units[exponent];
	},
	pick(event) {
		const file = event.target.files[0];
		if (!file) {
			return;
		}
		this.name = file.name;
		this.size = this.formatBytes(file.size);
		this.extension = file.name.includes('.') ? file.name.split('.').pop() : 'none';
	}
}`

// Drive is the home page of a signed-in account: the contents of the root
// folder, or of the folder the address bar names.
templ Drive(view View, title string, page response.Drive) {
	@Layout(title, view) {
		@DriveContent(page)
	}
}

// DriveContent is the fragment htmx swaps into <main> on client-side
// navigation between folders. The drawer is part of the page, so every action
// opens in the same panel on the right.
templ DriveContent(page response.Drive) {
	@PageColumnWide() {
		<div class="drawer drawer-end">
			<input
				id="entry-drawer"
				type="checkbox"
				class="drawer-toggle"
				autocomplete="off"
			/>
			<div class="drawer-content flex flex-col gap-4">
				<section class="card bg-base-100 shadow">
					<div class="card-body gap-4">
						@DriveToolbar(page)
						<progress id="download-progress" class="progress progress-primary w-full hidden" value="0" max="100"></progress>
						@EntrySearchForm(page)
						<div
							id="drive-entries"
							class="overflow-x-auto"
							data-folder-id={ page.FolderID }
						>
							@DriveEntries(page)
						</div>
					</div>
				</section>
			</div>
			<div class="drawer-side z-30">
				<label for="entry-drawer" aria-label="Close the panel" class="drawer-overlay"></label>
				<aside id="entry-panel" class="bg-base-100 min-h-full w-1/2"></aside>
			</div>
		</div>
	}
}

// DriveToolbar is the path above the listing together with the actions of the
// folder. The path owns the free width and scrolls on its own; the actions keep
// their size, so a deep path never moves them.
templ DriveToolbar(page response.Drive) {
	<div class="flex w-full flex-nowrap items-center gap-3">
		<nav
			aria-label="Breadcrumb"
			class="breadcrumbs min-w-0 flex-1 overflow-x-auto text-sm"
		>
			<ul>
				for _, crumb := range page.Breadcrumb {
					<li>
						if crumb.Current {
							<span aria-current="page">{ crumb.Name }</span>
						} else {
							<a
								href={ templ.URL(crumb.Href) }
								hx-get={ crumb.Href }
								hx-target="#page-content"
								hx-swap="innerHTML"
								hx-push-url="true"
							>{ crumb.Name }</a>
						}
					</li>
				}
			</ul>
		</nav>
		<div class="ml-auto flex shrink-0 items-center gap-2">
			<button
				type="button"
				class="btn btn-sm whitespace-nowrap"
				hx-get="/htmx/folders/tree"
				hx-target="#entry-panel"
				hx-swap="innerHTML"
				hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
			>
				Navigate
			</button>
			<button
				type="button"
				class="btn btn-sm whitespace-nowrap"
				hx-get={ "/htmx/folders/new?folder=" + page.FolderID }
				hx-target="#entry-panel"
				hx-swap="innerHTML"
				hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
					<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.5l-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z"></path>
					<path d="M12 11v6"></path>
					<path d="M9 14h6"></path>
				</svg>
				New folder
			</button>
			<a
				class="btn btn-sm whitespace-nowrap"
				href={ "/folders/" + page.FolderID + "/download" }
				if page.IsRoot {
					data-download-name="drive.zip"
				} else {
					data-download-name={ page.FolderName + ".zip" }
				}
				onclick="downloadWithProgress(this.href, this.dataset.downloadName); return false;"
			>
				Download folder
			</a>
			<button
				type="button"
				class="btn btn-sm btn-primary whitespace-nowrap"
				hx-get={ "/htmx/files/new?folder=" + page.FolderID }
				hx-target="#entry-panel"
				hx-swap="innerHTML"
				hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
					<path d="M12 15V3"></path>
					<path d="m7 8 5-5 5 5"></path>
					<path d="M5 21h14"></path>
				</svg>
				Upload file
			</button>
		</div>
	</div>
}

// EntrySearchForm narrows the entries of the page on screen. It is a plain GET
// form, so it works without JavaScript, and htmx swaps only the page content
// when it is available. The scope control decides whether the term narrows this
// folder or leaves for the whole-drive search; the folder route answers the
// latter with a redirect, so no second rendering path exists here.
//
// The search page reuses the form with its own state: the scope starts on All
// files, the source folder rides along in a hidden field, and a Clear link
// returns to the folder the search came from.
templ EntrySearchForm(page response.Drive) {
	<form
		class="flex w-full flex-wrap items-center gap-2"
		method="get"
		action={ page.SearchAction }
		hx-get={ page.SearchAction }
		hx-target="#page-content"
		hx-swap="innerHTML"
		hx-push-url="true"
	>
		<input
			class="input w-full flex-1"
			type="search"
			name="q"
			value={ page.Search }
			if page.SearchMode {
				placeholder="Search your drive"
				aria-label="Search your drive"
			} else {
				placeholder="Search this folder"
				aria-label="Search this folder"
			}
			maxlength="100"
			autocomplete="off"
		/>
		if page.SearchMode {
			if page.From != "" {
				<input type="hidden" name="from" value={ page.From }/>
				<select class="select select-bordered" name="scope" aria-label="Search scope">
					<option value="folder">This folder</option>
					<option value="all" selected>All files</option>
				</select>
			} else {
				<input type="hidden" name="scope" value="all"/>
			}
		} else {
			<select class="select select-bordered" name="scope" aria-label="Search scope">
				<option value="folder" selected>This folder</option>
				<option value="all">All files</option>
			</select>
		}
		<button type="submit" class="btn">Search</button>
		if page.SearchMode {
			<a
				class="btn btn-ghost"
				href={ templ.URL(page.ClearHref) }
				hx-get={ page.ClearHref }
				hx-target="#page-content"
				hx-swap="innerHTML"
				hx-push-url="true"
			>Clear</a>
		}
	</form>
}

// DriveEntries is the table of the folder, and the target every action
// refreshes. Folders come before files, both ordered by name. A filtered empty
// list is not an empty folder, so the two states say different things.
templ DriveEntries(page response.Drive) {
	if len(page.Folders) == 0 && len(page.Files) == 0 {
		<div class="rounded-box border-base-300 border border-dashed p-10 text-center">
			if page.Search != "" {
				<p class="text-base-content/70 text-sm">No matches in this folder.</p>
			} else {
				<p class="text-base-content/70 text-sm">This folder is empty.</p>
			}
		</div>
	} else {
		<table class="table table-zebra table-fixed w-full">
			<thead>
				<tr>
					<th>Name</th>
					<th class="w-32">Size</th>
					<th class="w-40">Modified</th>
					<th class="w-12 pe-0"><span class="sr-only">Actions</span></th>
				</tr>
			</thead>
			<tbody>
				@EntryRows(page)
			</tbody>
		</table>
	}
}

// entryPathCell is the location of one search result: the chain from the root,
// with the folder it ends at as the link back to the folder page. The click
// stops at the link, because the folder row it sits in opens the folder too.
templ entryPathCell(path, href string) {
	<td class="truncate">
		<a
			class="link"
			href={ templ.URL(href) }
			hx-get={ href }
			hx-target="#page-content"
			hx-swap="innerHTML"
			hx-push-url="true"
			@click.stop
		>{ path }</a>
	</td>
}

// EntryRows renders only the rows of a listing and the load-more sentinel,
// without the table around them. It is the body of the partial endpoint: htmx
// replaces the sentinel row with the rows it loaded and the sentinel that
// follows them.
//
// A whole-drive search reuses the rows in search mode: the location column
// appears, a file name downloads the file, and no row opens the action drawer,
// because a result is read-only until its folder is opened.
templ EntryRows(page response.Drive) {
	for _, folder := range page.Folders {
		<tr
			class="cursor-pointer hover:bg-base-200/50"
			aria-label={ "Open folder " + folder.Name }
			hx-get={ folder.Href }
			hx-target="#page-content"
			hx-swap="innerHTML"
			hx-push-url="true"
		>
			<td class="font-medium">
				<span class="flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 text-warning">
						<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.5l-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z"></path>
					</svg>
					<span
						class="block min-w-0 flex-1 truncate"
						data-full-name={ folder.Name }
						title={ folder.Name }
					>{ folder.Name }</span>
				</span>
			</td>
			if page.ShowPath {
				@entryPathCell(folder.Path, folder.PathHref)
			}
			<td class="whitespace-nowrap">{ folder.Items }</td>
			<td class="whitespace-nowrap">{ folder.Updated }</td>
			if !page.SearchMode {
				<td class="pe-0 text-right">
					<button
						type="button"
						class="btn btn-square btn-ghost btn-sm"
						aria-label={ "Actions for folder " + folder.Name }
						@click.stop
						hx-get={ "/htmx/folders/" + folder.ID + "/edit" }
						hx-target="#entry-panel"
						hx-swap="innerHTML"
						hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
							<circle cx="12" cy="5" r="1.7"></circle>
							<circle cx="12" cy="12" r="1.7"></circle>
							<circle cx="12" cy="19" r="1.7"></circle>
						</svg>
					</button>
				</td>
			}
		</tr>
	}
	for _, file := range page.Files {
		if page.SearchMode {
			<tr>
				<td class="font-medium">
					<span class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 text-base-content/60">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
							<path d="M14 2v6h6"></path>
						</svg>
						<a
							class="link block min-w-0 flex-1 truncate"
							href={ templ.URL("/files/" + file.ID + "/download") }
							data-full-name={ file.Name }
							title={ file.Name }
						>{ file.Name }</a>
					</span>
				</td>
				if page.ShowPath {
					@entryPathCell(file.Path, file.PathHref)
				}
				<td class="whitespace-nowrap">{ file.Size }</td>
				<td class="whitespace-nowrap">{ file.Updated }</td>
			</tr>
		} else {
			<tr
				class="cursor-pointer hover:bg-base-200/50"
				aria-label={ "Open " + file.Name }
				hx-get={ "/htmx/files/" + file.ID }
				hx-target="#entry-panel"
				hx-swap="innerHTML"
				hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
			>
				<td class="font-medium">
					<span class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 text-base-content/60">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
							<path d="M14 2v6h6"></path>
						</svg>
						<span
							class="block min-w-0 flex-1 truncate"
							data-full-name={ file.Name }
							title={ file.Name }
						>{ file.Name }</span>
					</span>
				</td>
				<td class="whitespace-nowrap">{ file.Size }</td>
				<td class="whitespace-nowrap">{ file.Updated }</td>
				<td class="pe-0 text-right">
					<button
						type="button"
						class="btn btn-square btn-ghost btn-sm"
						aria-label={ "Actions for " + file.Name }
						@click.stop
						hx-get={ "/htmx/files/" + file.ID }
						hx-target="#entry-panel"
						hx-swap="innerHTML"
						hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
							<circle cx="12" cy="5" r="1.7"></circle>
							<circle cx="12" cy="12" r="1.7"></circle>
							<circle cx="12" cy="19" r="1.7"></circle>
						</svg>
					</button>
				</td>
			</tr>
		}
	}
	if page.NextURL != "" {
		<tr>
			<td colspan={ driveEntryColumns } class="text-center">
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					hx-get={ page.NextURL }
					hx-target="closest tr"
					hx-swap="outerHTML"
					hx-sync="this:drop"
					hx-trigger="click, revealed"
				>
					Load more
				</button>
			</td>
		</tr>
	}
}

// Search is the whole-drive search page: one Search crumb, the form, and the
// results of every folder the account owns.
templ Search(view View, title string, page response.Drive) {
	@Layout(title, view) {
		@SearchContent(page)
	}
}

// SearchContent is the fragment htmx swaps into <main>. Results are read-only,
// so the page carries no drawer: a folder row opens the folder and a file row
// downloads the file, and the location of each row is the way back into the
// drive where its actions live.
templ SearchContent(page response.Drive) {
	@PageColumnWide() {
		<section class="card bg-base-100 shadow">
			<div class="card-body gap-4">
				<nav aria-label="Breadcrumb" class="breadcrumbs text-sm">
					<ul>
						for _, crumb := range page.Breadcrumb {
							<li>
								if crumb.Current {
									<span aria-current="page">{ crumb.Name }</span>
								} else {
									<a
										href={ templ.URL(crumb.Href) }
										hx-get={ crumb.Href }
										hx-target="#page-content"
										hx-swap="innerHTML"
										hx-push-url="true"
									>{ crumb.Name }</a>
								}
							</li>
						}
					</ul>
				</nav>
				@EntrySearchForm(page)
				if page.ShortSearch {
					<div class="rounded-box border-base-300 border border-dashed p-10 text-center">
						<p class="text-base-content/70 text-sm">Type at least three characters to search your drive.</p>
					</div>
				} else if len(page.Folders) == 0 && len(page.Files) == 0 {
					<div class="rounded-box border-base-300 border border-dashed p-10 text-center">
						<p class="text-base-content/70 text-sm">No results match that search.</p>
					</div>
				} else {
					<table class="table table-zebra table-fixed w-full">
						<thead>
							<tr>
								<th>Name</th>
								if page.ShowPath {
									<th>Location</th>
								}
								<th class="w-32">Size</th>
								<th class="w-40">Modified</th>
							</tr>
						</thead>
						<tbody>
							@SearchEntryRows(page)
						</tbody>
					</table>
				}
			</div>
		</section>
	}
}

// SearchEntryRows renders the rows of a search result page and the load-more
// sentinel, without the table around them. It is the body of the partial
// endpoint, and it shares the rows with the folder listing.
templ SearchEntryRows(page response.Drive) {
	@EntryRows(page)
}

// FolderCreateContent is the drawer form that creates one folder inside the
// folder on the screen.
templ FolderCreateContent(folderID string) {
	<div class="flex flex-col gap-4 p-4">
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-bold">New folder</h3>
			<label for="entry-drawer" aria-label="Close the panel" class="btn btn-circle btn-ghost btn-sm">✕</label>
		</div>
		<form
			class="flex flex-col gap-3"
			novalidate
			hx-post="/htmx/folders"
			hx-target="#drive-entries"
			hx-swap="innerHTML"
			hx-status:4xx="target:#folder-error"
			hx-status:5xx="target:#folder-error"
		>
			<input type="hidden" name="folder" value={ folderID }/>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Name</span>
				<input
					class="input w-full"
					type="text"
					name="name"
					required
					maxlength="255"
					autofocus
					autocomplete="off"
				/>
			</label>
			<div id="folder-error" class="text-error text-sm" role="alert"></div>
			<button type="submit" class="btn btn-primary">Create folder</button>
			<label for="entry-drawer" class="btn btn-ghost">Cancel</label>
		</form>
	</div>
}

// FolderEditContent is the drawer one folder opens from the actions button:
// the rename form and the delete action. A successful rename answers with an
// htmx location back to the parent, so the row comes back with the new name.
templ FolderEditContent(folderID, name string) {
	<div class="flex flex-col gap-4 p-4">
		<div class="flex items-start justify-between gap-2">
			<h3 class="text-lg font-bold break-all">{ name }</h3>
			<label for="entry-drawer" aria-label="Close the panel" class="btn btn-circle btn-ghost btn-sm">✕</label>
		</div>
		<form
			class="flex flex-col gap-3"
			novalidate
			hx-post={ "/htmx/folders/" + folderID + "/rename" }
			hx-target="#drive-entries"
			hx-swap="innerHTML"
			hx-status:4xx="target:#folder-edit-error"
			hx-status:5xx="target:#folder-edit-error"
		>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Name</span>
				<input
					class="input w-full"
					type="text"
					name="name"
					value={ name }
					required
					maxlength="255"
					autofocus
					autocomplete="off"
				/>
			</label>
			<div id="folder-edit-error" class="text-error text-sm" role="alert"></div>
			<button type="submit" class="btn btn-primary">Save name</button>
		</form>
		if name != "/" {
			<button
				type="button"
				class="btn btn-sm btn-outline whitespace-nowrap"
				hx-get={ "/htmx/folders/" + folderID + "/move" }
				hx-target="#entry-panel"
				hx-swap="innerHTML"
				hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
			>
				Move folder
			</button>
			<button
				type="button"
				class="btn btn-sm btn-outline whitespace-nowrap"
				hx-get={ "/htmx/folders/" + folderID + "/duplicate" }
				hx-target="#entry-panel"
				hx-swap="innerHTML"
				hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
			>
				Duplicate folder
			</button>
			<button
				type="button"
				class="btn btn-sm btn-outline whitespace-nowrap"
				hx-get={ "/htmx/folders/" + folderID + "/share" }
				hx-target="#entry-panel"
				hx-swap="innerHTML"
				hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
			>
				Share folder
			</button>
		}
		<form
			hx-post={ "/htmx/folders/" + folderID + "/delete" }
			hx-target="#drive-entries"
			hx-swap="innerHTML"
			hx-confirm="Delete this folder and everything in it?"
			hx-status:4xx="target:#folder-edit-error"
			hx-status:5xx="target:#folder-edit-error"
		>
			<button type="submit" class="btn btn-sm btn-error btn-outline">Delete folder</button>
		</form>
	</div>
}

// FileUploadContent is the drawer form that stores one file. Choosing the file
// fills the name field with its name and shows the size and the extension, so
// the visitor sees what is about to be sent before submitting. The submit is
// taken over by app.js, which sends the file in parts.
templ FileUploadContent(folderID string) {
	<div class="flex flex-col gap-4 p-4" x-data={ filePickerState }>
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-bold">Upload file</h3>
			<label for="entry-drawer" aria-label="Close the panel" class="btn btn-circle btn-ghost btn-sm">✕</label>
		</div>
		<form
			class="flex flex-col gap-3"
			novalidate
			onsubmit="return uploadFileWithProgress(this)"
		>
			<input type="hidden" name="folder" value={ folderID }/>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">File</span>
				<input
					class="file-input w-full"
					type="file"
					name="file"
					required
					@change="pick($event)"
				/>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Name</span>
				<input
					class="input w-full"
					type="text"
					name="name"
					x-model="name"
					required
					maxlength="255"
					autocomplete="off"
				/>
			</label>
			<p class="text-xs text-base-content/60">
				Size: <span x-text="size || '—'"></span>
				· Extension: <span x-text="extension || '—'"></span>
			</p>
			<progress id="upload-progress" class="progress progress-primary w-full hidden" value="0" max="100"></progress>
			<div id="upload-error" class="text-error text-sm" role="alert"></div>
			<button type="submit" class="btn btn-primary">Upload file</button>
			<label for="entry-drawer" class="btn btn-ghost">Cancel</label>
		</form>
	</div>
}

// FileDrawerContent is the drawer one file opens: what the file is, the
// download link, the rename form and the delete form.
templ FileDrawerContent(file response.FileInfo) {
	<div class="flex flex-col gap-4 p-4">
		<div class="flex items-start justify-between gap-2">
			<h3 class="text-lg font-bold break-all">{ file.Name }</h3>
			<label for="entry-drawer" aria-label="Close the panel" class="btn btn-circle btn-ghost btn-sm">✕</label>
		</div>
		<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
			<dt class="text-base-content/60">Size</dt>
			<dd>{ file.Size }</dd>
			<dt class="text-base-content/60">Type</dt>
			<dd class="break-all">{ file.Type }</dd>
			<dt class="text-base-content/60">Modified</dt>
			<dd>{ file.Updated }</dd>
		</dl>
		<a
			class="btn btn-primary"
			href={ templ.URL("/files/" + file.ID + "/download") }
			data-download-name={ file.Name }
			data-download-size={ strconv.FormatInt(file.Bytes, 10) }
			onclick="downloadWithProgress(this.href, this.dataset.downloadName, this.dataset.downloadSize); return false;"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
				<path d="M12 3v12"></path>
				<path d="m7 10 5 5 5-5"></path>
				<path d="M5 21h14"></path>
			</svg>
			Download
		</a>
		<button
			type="button"
			class="btn btn-sm btn-outline whitespace-nowrap"
			hx-get={ "/htmx/files/" + file.ID + "/move" }
			hx-target="#entry-panel"
			hx-swap="innerHTML"
			hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
				<path d="M9 2l5.5 5.5-5.5 5.5"></path>
				<path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7"></path>
			</svg>
			Move
		</button>
		<button
			type="button"
			class="btn btn-sm btn-outline whitespace-nowrap"
			hx-get={ "/htmx/files/" + file.ID + "/duplicate" }
			hx-target="#entry-panel"
			hx-swap="innerHTML"
			hx-on:htmx:after:swap="document.getElementById('entry-drawer').checked = true"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
				<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
				<rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
			</svg>
			Duplicate
		</button>
		<form
			class="flex flex-col gap-3"
			novalidate
			hx-post={ "/htmx/files/" + file.ID + "/rename" }
			hx-target="#drive-entries"
			hx-swap="innerHTML"
			hx-status:4xx="target:#entry-error"
			hx-status:5xx="target:#entry-error"
		>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Name</span>
				<input
					class="input w-full"
					type="text"
					name="name"
					value={ file.Name }
					required
					maxlength="255"
					autocomplete="off"
				/>
			</label>
			<div id="entry-error" class="text-error text-sm" role="alert"></div>
			<button type="submit" class="btn btn-sm">Save name</button>
		</form>
		<form
			hx-post={ "/htmx/files/" + file.ID + "/delete" }
			hx-target="#drive-entries"
			hx-swap="innerHTML"
			hx-confirm="Delete this file?"
			hx-status:4xx="target:#entry-error"
			hx-status:5xx="target:#entry-error"
		>
			<button type="submit" class="btn btn-sm btn-error btn-outline">Delete file</button>
		</form>
	</div>
}

// FolderMoveContent is the drawer form that moves one folder to another folder.
// The destination folder is picked from a select of the account's folders,
// indented by depth so the tree shape shows. The folder's current parent is
// pre-selected.
templ FolderMoveContent(folderID string, currentFolderID string, folders []response.FolderOption) {
	<div class="flex flex-col gap-4 p-4">
		<div class="flex items-start justify-between gap-2">
			<h3 class="text-lg font-bold">Move folder</h3>
			<label for="entry-drawer" aria-label="Close the panel" class="btn btn-circle btn-ghost btn-sm">✕</label>
		</div>
		<form
			class="flex flex-col gap-3"
			novalidate
			hx-post={ "/htmx/folders/" + folderID + "/move" }
			hx-target="#drive-entries"
			hx-swap="innerHTML"
			hx-status:4xx="target:#move-error"
			hx-status:5xx="target:#move-error"
		>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium">Destination folder</span>
				<select
					class="select select-bordered w-full"
					name="folder"
					required
					autofocus
				>
					for _, f := range folders {
						<option value={ f.ID } if f.ID == currentFolderID { selected } style={ f.Style }>{ f.Name }</option>
					}
				</select>
			</label>
			<div id="move-error" class="text-error text-sm" role="alert"></div>
			<button type="submit" class="btn btn-primary">Move folder</button>
			<label for="entry-drawer" class="btn btn-ghost">Cancel</label>
		</form>
	</div>
}

