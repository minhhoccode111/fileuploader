# App
APP_NAME=file-uploader
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8090
HTTP_USE_PREFORK_MODE=true
# Fake network latency applied to every request (set the max to 0 to turn it off)
HTTP_FAKE_LATENCY_MIN=100ms
HTTP_FAKE_LATENCY_MAX=200ms
# Logger
LOG_LEVEL=debug
# PG
PG_POOL_MAX=10
PG_URL=postgres://user:password@localhost:5433/fileuploader
# Redis
REDIS_ADDR=localhost:6379
# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=P@55w0rd
MINIO_USE_SSL=false
MINIO_BUCKET=files
# Host the browser reaches the bucket at (defaults to MINIO_ENDPOINT)
MINIO_PUBLIC_ENDPOINT=localhost:9000
# Uploads
# Largest accepted file in bytes (default 10 GiB), part size, idle time before
# an abandoned upload is swept, and the request body timeout. A throttled
# upload may need a longer timeout; zero disables the read deadline.
UPLOAD_MAX_BYTES=10737418240
UPLOAD_PART_BYTES=52428800
UPLOAD_SESSION_IDLE_TTL=1h
UPLOAD_TIMEOUT=5m
# Global limits. Zero means unlimited. A per-account value of zero inherits
# these defaults.
STORAGE_DEFAULT_QUOTA_BYTES=0
UPLOAD_DEFAULT_RATE_BYTES_PER_SEC=0
DOWNLOAD_DEFAULT_RATE_BYTES_PER_SEC=0
# Session
SESSION_TTL=24h
